# Copy to .env (never commit .env). Only needed for the api backend.
# Anthropic API key, read by the Anthropic SDK:
ANTHROPIC_API_KEY=
# Model backend for uncached calls: api (Anthropic SDK, default; the real run) or cli (headless claude -p)
MODEL_BACKEND=api
# Optional cache folder (default code/cache). Use an empty folder to force fresh calls,
# e.g. GHOST_CACHE_DIR=code/cache_api for the final API run whose usage is reported.
GHOST_CACHE_DIR=
